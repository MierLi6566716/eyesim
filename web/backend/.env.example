# Copy to .env for local dev. Sensible defaults exist for everything except
# the Supabase keys, which are only required for the simulate/diagnose/
# gallery routes (added in later phases) — /api/health and /api/psf work
# with zero configuration.

DATABASE_URL=sqlite:///./dev.db
# docker-compose provides: postgresql+psycopg2://eyesim:eyesim@localhost:5432/eyesim
# Supabase provides a connection string in Project Settings > Database.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=eyesim-cases

CORS_ORIGINS=["http://localhost:5173"]
